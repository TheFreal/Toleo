<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark translucent track with a white bar (tinted with the cover's colour from Android 12);
    widget_progress_shadowed_outline draws its dark outline. Legible on light and dark wallpapers.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#73000000" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </scale>
    </item>
</layer-list>
